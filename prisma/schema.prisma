datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  DECLINED
  SPAM
}

enum WorkStatus {
  NOMINATED
  ACCREDITED
  ARCHIVED
}

enum RecognitionTier {
  CATEGORY_WINNER   @map("Category Winner")
  EDITORS_SELECTION @map("Editor's Selection")
  FEATURED          @map("Featured")
  HONORABLE_MENTION @map("Honorable Mention")
}

enum MediaAspectRatio {
  LANDSCAPE @map("landscape")
  PORTRAIT  @map("portrait")
  SQUARE    @map("square")
  TALL      @map("tall")
}

enum GridSpan {
  LARGE  @map("large")
  MEDIUM @map("medium")
  SMALL  @map("small")
  TALL   @map("tall")
}

enum SubmitterRole {
  CREATOR    @map("creator")
  STUDIO_REP @map("studio_rep")
  CLIENT     @map("client")
  PEER       @map("peer")
}

enum UserRole {
  ADMIN   @map("admin")
  CURATOR @map("curator")
  CREATOR @map("creator")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(50)
  slug        String       @unique @db.VarChar(50)
  indexNumber Int          @unique @map("index_number") @db.SmallInt
  description String       @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  works       Work[]
  submissions Submission[]

  @@map("categories")
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  email               String             @unique @db.VarChar(255)
  name                String             @db.VarChar(100)
  role                UserRole           @default(CREATOR)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  claimedCreators     Creator[]          @relation("ClaimedCreators")
  reviewedSubmissions Submission[]       @relation("ReviewedSubmissions")
  appreciations       WorkAppreciation[]

  @@map("users")
}

model Creator {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(100)
  name            String   @db.VarChar(100)
  role            String   @db.VarChar(100)
  city            String   @db.VarChar(50)
  location        String   @db.VarChar(100)
  initials        String   @db.VarChar(4)
  bio             String   @db.Text
  website         String?  @db.VarChar(255)
  instagramHandle String?  @map("instagram_handle") @db.VarChar(50)
  twitterHandle   String?  @map("twitter_handle") @db.VarChar(50)
  claimed         Boolean  @default(false)
  claimedByUserId String?  @map("claimed_by_user_id") @db.Uuid
  claimedByUser   User?    @relation("ClaimedCreators", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  works           Work[]

  @@index([city])
  @@map("creators")
}

model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  trackingCode     String           @unique @map("tracking_code") @db.VarChar(32)
  submitterName    String           @map("submitter_name") @db.VarChar(100)
  submitterEmail   String           @map("submitter_email") @db.VarChar(255)
  submitterRole    SubmitterRole    @map("submitter_role")
  projectTitle     String           @map("project_title") @db.VarChar(150)
  creatorName      String           @map("creator_name") @db.VarChar(100)
  creatorWebsite   String?          @map("creator_website") @db.VarChar(255)
  projectUrl       String           @map("project_url") @db.VarChar(500)
  categoryId       String           @map("category_id") @db.Uuid
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  locationHub      String           @map("location_hub") @db.VarChar(100)
  description      String           @db.Text
  tempAssetUrls    Json             @default("[]") @map("temp_asset_urls")
  status           SubmissionStatus @default(PENDING)
  curatorNotes     String?          @map("curator_notes") @db.Text
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser   User?            @relation("ReviewedSubmissions", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz
  ipHash           String           @map("ip_hash") @db.VarChar(64)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  promotedWork     Work?

  @@index([status])
  @@index([submitterEmail])
  @@map("submissions")
}

model Work {
  id                String             @id @default(uuid()) @db.Uuid
  title             String             @db.VarChar(150)
  slug              String             @unique @db.VarChar(160)
  creatorId         String             @map("creator_id") @db.Uuid
  creator           Creator            @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  categoryId        String             @map("category_id") @db.Uuid
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  submissionId      String?            @unique @map("submission_id") @db.Uuid
  submission        Submission?        @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  location          String             @db.VarChar(100)
  city              String             @db.VarChar(50)
  summary           String             @db.VarChar(500)
  description       String             @db.Text
  clientOrContext   String?            @map("client_or_context") @db.VarChar(150)
  year              String             @db.Char(4)
  aspectRatio       MediaAspectRatio   @default(LANDSCAPE) @map("aspect_ratio")
  span              GridSpan           @default(MEDIUM)
  status            WorkStatus         @default(NOMINATED)
  recognitionTier   RecognitionTier?   @map("recognition_tier")
  score             Decimal?           @db.Decimal(4, 2)
  appreciationCount Int                @default(0) @map("appreciation_count")
  publishedAt       DateTime           @default(now()) @map("published_at") @db.Timestamptz
  accreditedAt      DateTime?          @map("accredited_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  media             WorkMedia[]
  tags              WorkTag[]
  appreciations     WorkAppreciation[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([creatorId])
  @@index([categoryId])
  @@index([recognitionTier])
  @@index([city])
  @@index([appreciationCount(sort: Desc)])
  @@map("works")
}

model WorkMedia {
  id           String           @id @default(uuid()) @db.Uuid
  workId       String           @map("work_id") @db.Uuid
  work         Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  url          String           @db.VarChar(500)
  aspectRatio  MediaAspectRatio @default(LANDSCAPE) @map("aspect_ratio")
  caption      String?          @db.VarChar(255)
  altText      String           @map("alt_text") @db.VarChar(255)
  isPrimary    Boolean          @default(false) @map("is_primary")
  displayOrder Int              @default(0) @map("display_order") @db.SmallInt
  width        Int?
  height       Int?
  blurDataUrl  String?          @map("blur_data_url") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workId, displayOrder])
  @@index([workId])
  @@map("work_media")
}

model WorkTag {
  id        String   @id @default(uuid()) @db.Uuid
  workId    String   @map("work_id") @db.Uuid
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workId, tag])
  @@index([tag])
  @@index([workId])
  @@map("work_tags")
}

model WorkAppreciation {
  id        String   @id @default(uuid()) @db.Uuid
  workId    String   @map("work_id") @db.Uuid
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  ipHash    String   @map("ip_hash") @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workId, ipHash])
  @@index([workId])
  @@map("work_appreciations")
}
